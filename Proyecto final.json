      "parameters": {
        "content": "Esta primer parte del workflow, revisa todos los días a las 9am el precio del dolar, y agrega la información al archivo comercial por si una consulta lo requiere.",
        "color": 3
      },
      "type": "n8n-nodes-base.stickyNote",
