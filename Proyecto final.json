    {
      "parameters": {
        "jsCode": "\nconst dolar = Number(\n  $('Consulta a la API del precio del dolar').first().json.venta\n);\n\nif (!Number.isFinite(dolar) || dolar <= 0) {\n  throw new Error('Cotización del dólar inválida');\n}\n\nreturn $input.all().map(item => {\n\n  // Tomamos el costo original en pesos\n  const costoArs = Number(item.json.costo_ars);\n\n  if (!Number.isFinite(costoArs) || costoArs <= 0) {\n    return {\n      json: {\n        ...item.json,\n        costo_usd: null,\n        estado: 'Falta cargar costo ARS'\n      }\n    };\n  }\n\n  // Convertimos pesos a dólares\n  const costoUsd = costoArs / dolar;\n\n  return {\n    json: {\n      ...item.json,\n      costo_usd: Number(costoUsd.toFixed(2)),\n      dolar_venta: dolar,\n      fecha_actualizacion: new Date().toISOString(),\n      estado: 'Actualizado'\n    }\n  };\n});\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
